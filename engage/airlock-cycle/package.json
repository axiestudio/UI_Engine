{
  "name": "airlock-cycle",
  "version": "0.1.0",
  "description": "Two-door airlock auth cycle \u2014 inner door opens only after outer seals",
  "type": "module",
  "main": "dist/airlock-cycle.cjs.js",
  "module": "dist/airlock-cycle.es.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/airlock-cycle.es.js",
      "require": "./dist/airlock-cycle.cjs.js"
    },
    "./styles.css": "./dist/airlock-cycle.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "original-design": true,
    "vendored": "in-repo primitives: \u2014 + handcraft kit",
    "motion": "motion/react",
    "watermelon-ui": [
      "https://registry.watermelon.sh/r/button.json"
    ]
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.4.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "license": "MIT"
}

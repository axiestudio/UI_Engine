{
  "name": "schedule",
  "version": "0.1.0",
  "description": "Opening-hours + upcoming-appointments preset with next-available booking button (Watermelon UI + Motion-Primitives)",
  "type": "module",
  "main": "dist/schedule.cjs.js",
  "module": "dist/schedule.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/schedule.es.js",
      "require": "./dist/schedule.cjs.js"
    },
    "./styles.css": "./dist/schedule.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "motion-primitives": [
      "magnetic",
      "in-view"
    ],
    "watermelon-ui": [
      "https://registry.watermelon.sh/r/schedule-date.json",
      "https://registry.watermelon.sh/r/schedule-date-base.json",
      "https://registry.watermelon.sh/r/schedule-button.json",
      "https://registry.watermelon.sh/r/button.json"
    ]
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "framer-motion": "^13.1.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  }
}

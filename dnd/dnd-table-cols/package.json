{
  "name": "dnd-table-cols",
  "version": "0.1.0",
  "description": "Table column reordering \u2014 horizontal sortable header + matching body cells",
  "type": "module",
  "main": "dist/dnd-table-cols.cjs.js",
  "module": "dist/dnd-table-cols.es.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dnd-table-cols.es.js",
      "require": "./dist/dnd-table-cols.cjs.js"
    },
    "./styles.css": "./dist/dnd-table-cols.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "dnd-kit": [
      "@dnd-kit/core",
      "@dnd-kit/sortable",
      "@dnd-kit/utilities",
      "@dnd-kit/modifiers"
    ],
    "shadcn-ui": [
      "https://ui.shadcn.com/r/styles/new-york-v4/button.json"
    ],
    "motion-primitives": [
      "in-view"
    ]
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@dnd-kit/modifiers": "^9.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "radix-ui": "^1.4.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  }
}

{
  "name": "event-timeline-day",
  "version": "0.1.0",
  "description": "Activity timeline \u2014 day groups, hover detail card, presence dots",
  "type": "module",
  "main": "dist/event-timeline-day.js",
  "module": "dist/event-timeline-day.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/event-timeline-day.es.js",
      "require": "./dist/event-timeline-day.cjs.js"
    },
    "./styles.css": "./dist/event-timeline-day.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "original-design": true,
    "vendored": "handcraft kit (in-repo)",
    "motion": "motion/react"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "clsx": "^2.1.1",
    "motion": "^13.1.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "license": "MIT"
}

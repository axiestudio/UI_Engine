{
  "name": "activity-heatmap",
  "version": "0.1.0",
  "description": "GitHub-style activity heatmap \u2014 Bklit HeatmapChart pattern: fluid week columns, level scale tokens, bloom entrance, tooltip + legend",
  "type": "module",
  "main": "dist/activity-heatmap.js",
  "module": "dist/activity-heatmap.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/activity-heatmap.es.js",
      "require": "./dist/activity-heatmap.cjs.js"
    },
    "./styles.css": "./dist/activity-heatmap.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "original-design": true,
    "motion": "motion/react",
    "bklit-ui": [
      "src/components/bklit/animation.ts",
      "src/components/bklit/chart-child-passthrough.ts",
      "src/components/bklit/chart-config-context.tsx",
      "src/components/bklit/chart-context.tsx",
      "src/components/bklit/chart-loading-label.tsx",
      "src/components/bklit/chart-phase.ts",
      "src/components/bklit/chart-scale.ts",
      "src/components/bklit/line-loading-timing.ts",
      "src/components/bklit/motion-utils.ts",
      "src/components/bklit/pattern-preset.tsx",
      "src/components/bklit/visx-pattern.tsx",
      "src/components/bklit/tooltip/tooltip-box.tsx",
      "src/components/bklit/heatmap/heatmap-animation.ts",
      "src/components/bklit/heatmap/heatmap-cells.tsx",
      "src/components/bklit/heatmap/heatmap-chart.tsx",
      "src/components/bklit/heatmap/heatmap-colors.ts",
      "src/components/bklit/heatmap/heatmap-context.tsx",
      "src/components/bklit/heatmap/heatmap-legend-gradient.tsx",
      "src/components/bklit/heatmap/heatmap-legend-swatch.tsx",
      "src/components/bklit/heatmap/heatmap-legend.tsx",
      "src/components/bklit/heatmap/heatmap-pattern-defs.tsx",
      "src/components/bklit/heatmap/heatmap-resolve-separator.ts",
      "src/components/bklit/heatmap/heatmap-separator.tsx",
      "src/components/bklit/heatmap/heatmap-tooltip.tsx",
      "src/components/bklit/heatmap/heatmap-utils.ts",
      "src/components/bklit/heatmap/heatmap-y-axis.tsx",
      "src/components/bklit/heatmap/use-delayed-tooltip-data.ts",
      "src/components/primitives/shimmering-text.tsx"
    ],
    "watermelon-ui": [
      "https://registry.watermelon.sh/r/badge.json"
    ]
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@visx/group": "^4.0.1-alpha.0",
    "@visx/heatmap": "^4.0.1-alpha.0",
    "@visx/pattern": "^4.0.1-alpha.0",
    "@visx/responsive": "^4.0.1-alpha.0",
    "@visx/scale": "^4.0.1-alpha.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.1.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "license": "MIT"
}

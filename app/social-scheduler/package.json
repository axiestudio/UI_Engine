{
  "name": "social-scheduler",
  "version": "0.1.0",
  "description": "Queue the week: cadence cron with next-runs, network segments, post composer with @mentions, heat of past reach, reply inbox",
  "type": "module",
  "main": "dist/social-scheduler.cjs.js",
  "module": "dist/social-scheduler.es.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/social-scheduler.es.js",
      "require": "./dist/social-scheduler.cjs.js"
    },
    "./styles.css": "./dist/social-scheduler.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "motion-primitives": [
      "in-view"
    ],
    "watermelon-ui": [
      "https://registry.watermelon.sh/r/card.json",
      "https://registry.watermelon.sh/r/select.json"
    ]
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0",
    "@radix-ui/react-select": "^2.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  }
}

{
  "name": "finance-desk",
  "version": "0.1.0",
  "description": "Close the month: editable ledger rows, burn-rate gauge on a big dial, receipt drop queue, API keys, and a trail that re-stamps honest reversions",
  "type": "module",
  "main": "dist/finance-desk.cjs.js",
  "module": "dist/finance-desk.es.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/finance-desk.es.js",
      "require": "./dist/finance-desk.cjs.js"
    },
    "./styles.css": "./dist/finance-desk.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "motion-primitives": [
      "sliding-number",
      "in-view"
    ],
    "watermelon-ui": [
      "https://registry.watermelon.sh/r/table.json",
      "https://registry.watermelon.sh/r/card.json",
      "https://registry.watermelon.sh/r/button.json"
    ]
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@visx/event": "*",
    "@visx/grid": "*",
    "@visx/responsive": "*",
    "@visx/scale": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0",
    "react-use-measure": "^2.1.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  }
}

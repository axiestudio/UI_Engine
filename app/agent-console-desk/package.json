{
  "name": "agent-console-desk",
  "version": "0.1.0",
  "description": "AI ops cockpit: composer with token ring, streamed answers barw with cites, change-approval hunks, agent job tray",
  "type": "module",
  "main": "dist/agent-console-desk.cjs.js",
  "module": "dist/agent-console-desk.es.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/agent-console-desk.es.js",
      "require": "./dist/agent-console-desk.cjs.js"
    },
    "./styles.css": "./dist/agent-console-desk.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "motion-primitives": [
      "in-view"
    ],
    "watermelon-ui": [
      "https://registry.watermelon.sh/r/card.json",
      "https://registry.watermelon.sh/r/button.json",
      "https://ui.shadcn.com/r/styles/new-york-v4/button-group.json",
      "https://registry.watermelon.sh/r/tooltip.json",
      "https://registry.watermelon.sh/r/collapsible.json",
      "https://registry.watermelon.sh/r/separator.json"
    ],
    "ai-elements": [
      "https://registry.ai-sdk.dev/message.json",
      "https://registry.ai-sdk.dev/sources.json",
      "https://registry.ai-sdk.dev/loader.json",
      "https://registry.ai-sdk.dev/shimmer.json"
    ],
    "engine-libraries": [
      "sonner"
    ]
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "ai": "^7.0.87",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "radix-ui": "^1.6.7",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  }
}

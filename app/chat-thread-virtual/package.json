{
  "name": "chat-thread-virtual",
  "version": "0.1.0",
  "description": "Message thread \u2014 date dividers, streaming tail pin, reply-quote rails, reedit window",
  "type": "module",
  "main": "dist/chat-thread-virtual.js",
  "module": "dist/chat-thread-virtual.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/chat-thread-virtual.es.js",
      "require": "./dist/chat-thread-virtual.cjs.js"
    },
    "./styles.css": "./dist/chat-thread-virtual.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "original-design": true,
    "motion": "motion/react",
    "watermelon-ui": [
      "https://registry.watermelon.sh/r/button.json",
      "https://ui.shadcn.com/r/styles/new-york-v4/button-group.json",
      "https://registry.watermelon.sh/r/tooltip.json",
      "https://registry.watermelon.sh/r/separator.json",
      "https://registry.watermelon.sh/r/input.json"
    ],
    "ai-elements": [
      "https://registry.ai-sdk.dev/conversation.json",
      "https://registry.ai-sdk.dev/message.json",
      "https://registry.ai-sdk.dev/loader.json",
      "https://registry.ai-sdk.dev/shimmer.json"
    ]
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "ai": "^7.0.87",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "radix-ui": "^1.6.7",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "license": "MIT"
}

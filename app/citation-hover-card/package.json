{
  "name": "citation-hover-card",
  "version": "0.1.0",
  "description": "Inline [n] citations \u2014 source hover card with snippet, domain favicon slot, pin list",
  "type": "module",
  "main": "dist/citation-hover-card.js",
  "module": "dist/citation-hover-card.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/citation-hover-card.es.js",
      "require": "./dist/citation-hover-card.cjs.js"
    },
    "./styles.css": "./dist/citation-hover-card.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "original-design": true,
    "motion": "motion/react",
    "watermelon-ui": [
      "https://registry.watermelon.sh/r/button.json",
      "https://registry.watermelon.sh/r/badge.json",
      "https://ui.shadcn.com/r/styles/new-york-v4/carousel.json",
      "https://registry.watermelon.sh/r/hover-card.json"
    ],
    "ai-elements": [
      "https://registry.ai-sdk.dev/inline-citation.json"
    ]
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "radix-ui": "^1.6.7",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "license": "MIT"
}

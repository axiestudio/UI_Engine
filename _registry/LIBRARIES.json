  "router": [
    {
      "need": "button / card / dialog / form / tabs / navigation \u2014 standard UI",
      "use": "shadcn/ui",
      "via": "watermelon snapshot"
    },
    {
      "need": "a standard component shadcn lacks, or a ready website section",
      "use": "watermelon-ui",
      "via": "--wm"
    },
    {
      "need": "high-visual-identity website components: animated text, backgrounds, effects",
      "use": "React Bits",
      "via": "--reg react-bits"
    },
    {
      "need": "modern interactive sections, animated cards, effects",
      "use": "Cult UI",
      "via": "--reg cult-ui"
    },
    {
      "need": "playful animated cards, hover/background/text effects",
      "use": "Animata",
      "via": "--reg animata"
    },
    {
      "need": "device/browser mockup (iPhone, iPad, MacBook, Safari)",
      "use": "Eldora UI (or in-repo device-stage presets first)",
      "via": "--reg eldora-ui"
    },
    {
      "need": "hero / landing layout inspiration",
      "use": "Tailark (inspiration only \u2014 not a dependency)",
      "via": null
    },
    {
      "need": "entrance / in-view / text / hover animation",
      "use": "motion-primitives",
      "via": "--mp"
    },
    {
      "need": "complex timeline, scroll-scrubbed scene, Flip, drag physics, SVG draw",
      "use": "GSAP",
      "via": "--lib gsap"
    },
    {
      "need": "stagger choreography, SVG morph/draw, Draggable, scramble text \u2014 full engine, low ceremony",
      "use": "Anime.js v4",
      "via": "--lib animejs"
    },
    {
      "need": "smooth page scroll for premium landing pages",
      "use": "Lenis",
      "via": "--lib lenis"
    },
    {
      "need": "physics-driven motion that follows React state (interruptible)",
      "use": "React Spring",
      "via": "--lib react-spring"
    },
    {
      "need": "tooltip / popover / dropdown / floating toolbar positioning",
      "use": "Floating UI",
      "via": "--lib floating-ui"
    },
    {
      "need": "carousel, gallery, draggable rail, slider",
      "use": "Embla Carousel",
      "via": "--lib embla"
    },
    {
      "need": "draggable bottom sheet / drawer",
      "use": "Vaul",
      "via": "--lib vaul"
    },
    {
      "need": "toast notifications",
      "use": "Sonner",
      "via": "--lib sonner"
    },
    {
      "need": "polished, design-statement charts",
      "use": "Bklit UI",
      "via": "--bk"
    },
    {
      "need": "plain utility charts in app surfaces",
      "use": "Recharts",
      "via": "--lib recharts"
    },
    {
      "need": "large datasets / advanced interactive visualization",
      "use": "Apache ECharts",
      "via": "--lib echarts"
    },
    {
      "need": "3D scenes / interactive WebGL in React",
      "use": "React Three Fiber (on Three.js)",
      "via": "--lib react-three-fiber"
    },
    {
      "need": "animation that responds to interaction/state (authored art)",
      "use": "Rive",
      "via": "--lib rive"
    },
    {
      "need": "designer-authored animation assets that just play",
      "use": "Lottie",
      "via": "--lib lottie"
    }
  ],
  "tiers": {
    "foundation": [
      "shadcn/ui",
      "watermelon-ui"
    ],
    "website-design": [
      "react-bits",
      "cult-ui",
      "animata"
    ],
    "presentation": [
      "eldora-ui",
      "tailark (inspiration)"
    ],
    "animation": [
      "motion-primitives",
      "gsap",
      "animejs",
      "lenis",
      "react-spring"
    ],
    "interaction": [
      "floating-ui",
      "embla",
      "vaul",
      "sonner"
    ],
    "visualization": [
      "bklit",
      "recharts",
      "echarts"
    ],
    "3d": [
      "threejs",
      "react-three-fiber",
      "rive",
      "lottie"
    ]
  },
  "tiersNotice": "Tier names mirror UI/PRINCIPLE_READ_ME.md \u00a7'Overall Stack'. 23 libraries + handcraft.",
  "decisionOrder": "Before writing any component, ask in order: 1 shadcn? 2 watermelon? 3 React Bits/Cult UI/Animata? 4 specialized library (this index)? 5 compose, don't copy. Only then handcraft."
}

{
  "$comment": "Index of UI/_registry \u2014 the library stack. 23 sources = the libraries of UI/PRINCIPLE_READ_ME.md; sections are composed per preset from tokens (the former handcraft kit is RETIRED: handcraft/library.json). Tiers follow UI/DESIGN_PRICIPLE.md. Workspace rule: libraries own functionality, WE own design (composition, layout, typography, hierarchy, brand). Reuse first. Compose second. Customize third. Rebuild last.",
  "version": 2,
  "count": 23,
  "sources": [
    {
      "name": "shadcn/ui",
      "dir": null,
      "kind": "external-foundation",
      "tier": "foundation",
      "homepage": "https://ui.shadcn.com",
      "note": "The base component system. Reached through the watermelon snapshot (registry.watermelon.sh serves shadcn-compatible items; kit names button/card/dialog/\u2026 resolve to shadcn base items).",
      "docs": "https://ui.shadcn.com/docs"
    },
    {
      "name": "watermelon-ui",
      "dir": "watermelon",
      "kind": "registry",
      "tier": "foundation",
      "manifest": "watermelon/library.json",
      "homepage": "https://watermelontools.com",
      "upstream": "https://registry.watermelon.sh/r/<name>.json",
      "consume": "create-preset.py --wm item[,kit]"
    },
    {
      "name": "React Bits",
      "dir": "react-bits",
      "kind": "registry",
      "tier": "website-design",
      "manifest": "react-bits/library.json",
      "homepage": "https://reactbits.dev",
      "upstream": "https://reactbits.dev/r/<name>-TS-TW.json",
      "consume": "create-preset.py --reg react-bits:AnimatedContent"
    },
    {
      "name": "Cult UI",
      "dir": "cult-ui",
      "kind": "registry",
      "tier": "website-design",
      "manifest": "cult-ui/library.json",
      "homepage": "https://cult-ui.com",
      "upstream": "https://cult-ui.com/r/<name>.json (bot-checked; snapshot from repo)",
      "consume": "create-preset.py --reg cult-ui:cosmic-button"
    },
    {
      "name": "Animata",
      "dir": "animata",
      "kind": "source-snapshot",
      "tier": "website-design",

{
  "name": "sidebar-solid",
  "version": "0.1.0",
  "description": "Solid app sidebar \u2014 shadcn primitives (button, dropdown, select, avatar), Floating UI anchored panels, anime.js v4 motion, react-bits AnimatedList",
  "type": "module",
  "main": "dist/sidebar-solid.cjs.js",
  "module": "dist/sidebar-solid.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sidebar-solid.es.js",
      "require": "./dist/sidebar-solid.cjs.js"
    },
    "./styles.css": "./dist/sidebar-solid.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "motion-primitives": [],
    "watermelon-ui": [
      "https://registry.watermelon.sh/r/button.json",
      "https://registry.watermelon.sh/r/dropdown-menu.json",
      "https://registry.watermelon.sh/r/select.json",
      "https://registry.watermelon.sh/r/avatar.json",
      "https://registry.watermelon.sh/r/separator.json",
      "https://registry.watermelon.sh/r/badge.json"
    ],
    "bklit-ui": [],
    "registry-items": [
      "react-bits:AnimatedList"
    ],
    "engine-libraries": [
      "animejs",
      "floating-ui"
    ]
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@floating-ui/react": "^0.27.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "radix-ui": "^1.4.3",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  }
}

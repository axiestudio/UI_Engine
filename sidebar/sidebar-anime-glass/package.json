{
  "name": "sidebar-anime-glass",
  "version": "0.1.0",
  "description": "Glass tile launcher rail \u2014 react-bits GlassIcons, Floating UI preview cards, anime.js v4 stagger",
  "type": "module",
  "main": "dist/sidebar-anime-glass.cjs.js",
  "module": "dist/sidebar-anime-glass.es.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/sidebar-anime-glass.es.js",
      "require": "./dist/sidebar-anime-glass.cjs.js"
    },
    "./styles.css": "./dist/sidebar-anime-glass.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "motion-primitives": [],
    "watermelon-ui": [
      "https://registry.watermelon.sh/r/button.json",
      "https://registry.watermelon.sh/r/badge.json",
      "https://registry.watermelon.sh/r/separator.json",
      "https://registry.watermelon.sh/r/avatar.json"
    ],
    "bklit-ui": [],
    "registry-items": [
      "react-bits:GlassIcons"
    ],
    "engine-libraries": [
      "animejs",
      "floating-ui"
    ]
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0",
    "animejs": "^4.5.0",
    "@floating-ui/react": "^0.27.20",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  }
}

{
  "name": "faq",
  "version": "0.1.0",
  "description": "Professional FAQ preset \u2014 category chips, search with highlight, deep links, motion accordion (Watermelon UI + Motion-Primitives)",
  "type": "module",
  "main": "dist/faq.cjs.js",
  "module": "dist/faq.es.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/faq.es.js",
      "require": "./dist/faq.cjs.js"
    },
    "./styles.css": "./dist/faq.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "motion-primitives": [
      "accordion",
      "in-view",
      "magnetic"
    ],
    "watermelon-ui": [
      "https://registry.watermelon.sh/r/faq-2.json",
      "https://registry.watermelon.sh/r/accordion.json"
    ]
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "radix-ui": "^1.4.2",
    "react": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "license": "MIT"
}

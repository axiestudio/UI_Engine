{
  "name": "floating-pin-notes",
  "version": "0.1.0",
  "description": "Annotated image with numbered pins opening collision-aware floating notes (Floating UI)",
  "type": "module",
  "main": "dist/floating-pin-notes.cjs.js",
  "module": "dist/floating-pin-notes.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/floating-pin-notes.es.js",
      "require": "./dist/floating-pin-notes.cjs.js"
    },
    "./styles.css": "./dist/floating-pin-notes.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "motion-primitives": [
      "in-view"
    ],
    "watermelon-ui": []
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@floating-ui/react": "^0.27.20",
    "@floating-ui/react-dom": "^2.1.5",
    "clsx": "^2.1.1",
    "motion": "^13.1.1",
    "react": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0",
    "lucide-react": "^1.34.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "license": "MIT"
}

{
  "name": "cta",
  "version": "0.1.0",
  "description": "Professional call-to-action band preset \u2014 ink panel, shimmer heading, magnetic + border-trail buttons (Watermelon UI + Motion-Primitives)",
  "type": "module",
  "main": "dist/cta.cjs.js",
  "module": "dist/cta.es.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/cta.es.js",
      "require": "./dist/cta.cjs.js"
    },
    "./styles.css": "./dist/cta.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "motion-primitives": [
      "in-view",
      "magnetic",
      "text-shimmer",
      "spinning-text",
      "border-trail"
    ],
    "watermelon-ui": [
      "https://registry.watermelon.sh/r/cta-1.json",
      "https://registry.watermelon.sh/r/cta-2.json",
      "https://registry.watermelon.sh/r/badge.json",
      "https://registry.watermelon.sh/r/button.json"
    ]
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0",
    "@radix-ui/react-slot": "^1.3.3",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  }
}

{
  "name": "zigzag",
  "version": "0.1.0",
  "description": "Zig-zag tunnel with water \u2014 continuous scrub, left|tunnel|right",
  "type": "module",
  "main": "dist/zigzag.cjs.js",
  "module": "dist/zigzag.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/zigzag.es.js",
      "require": "./dist/zigzag.cjs.js"
    },
    "./styles.css": "./dist/zigzag.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "lint": "oxlint",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "motion": "^13.1.1"
  }
}

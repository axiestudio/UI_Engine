{
  "name": "hero-logo",
  "version": "0.1.0",
  "description": "Logo hero \u2014 a bold wordmark upfront to set the brand",
  "type": "module",
  "main": "dist/hero-logo.cjs.js",
  "module": "dist/hero-logo.es.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/hero-logo.es.js",
      "require": "./dist/hero-logo.cjs.js"
    },
    "./styles.css": "./dist/hero-logo.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "shadcn-ui": [
      "https://ui.shadcn.com/r/styles/new-york-v4/button.json"
    ],
    "motion-primitives": [
      "in-view"
    ]
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "radix-ui": "^1.4.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  }
}

{
  "name": "curtain-call",
  "version": "0.1.0",
  "description": "Theatre-curtain welcome reveal \u2014 scroll-panned twin panels peel apart over a hero (curtain-call), unmounting fully at open. Verbatim port of the engine gate, stage + overlay modes",
  "type": "module",
  "main": "dist/curtain-call.cjs.js",
  "module": "dist/curtain-call.es.js",
  "types": "dist/src/index.d.ts",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/curtain-call.es.js",
      "require": "./dist/curtain-call.cjs.js"
    },
    "./styles.css": "./dist/curtain-call.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "presetSources": {
    "replicated-from": "engine/src/Curtain.tsx",
    "design-dna": "theatre welcome gate \u2014 twin panels, lit seam, scrub-to-open, unmounts fully"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  }
}
